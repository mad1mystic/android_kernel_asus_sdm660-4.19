# =============================================================================
# Droidspaces + efficiency fragment — Mystic Kernel for X00TD
# (base: rusakseven/RSKSevenProject-X00TD-419, Linux 4.19.325)
# =============================================================================
# Merged at build time on top of vendor/asus/X00TD_defconfig:
#   make ARCH=arm64 X00TD_defconfig vendor/extra/ksu.config vendor/extra/droidspaces.config
# Last file wins, so this fragment is authoritative for every option below.
#
# Upstream reference: ravindu644/Droidspaces-OSS
#   Documentation/Kernel-Configuration.md  (non-GKI, kernels 3.18 - 4.19)
#
# Every symbol here was verified to exist as a Kconfig entry in THIS tree.
# The following options from the upstream docs are deliberately omitted
# because they do not exist on 4.19 (they are 5.x symbols, or were folded
# into another target):
#   CONFIG_FW_LOADER_COMPRESS              (added in 5.2)
#   CONFIG_NETFILTER_XT_TARGET_MASQUERADE  (built by CONFIG_IP_NF_TARGET_MASQUERADE)
#   CONFIG_NETFILTER_XT_TARGET_REJECT      (built by CONFIG_IP_NF_TARGET_REJECT)
#   CONFIG_NF_CONNTRACK_NETLINK            (removed before 4.19)
#   CONFIG_NF_CONNTRACK_IPV4               (legacy, gone; NF_CONNTRACK covers it)
#   CONFIG_NF_CONNTRACK_IPV6               (legacy, gone; NF_CONNTRACK covers it)
#   CONFIG_IP_NF_TARGET_ULOG               (removed before 4.19)
# =============================================================================

# --- IPC mechanisms ---------------------------------------------------------
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Core namespace support -------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y

# --- Seccomp support --------------------------------------------------------
# Droidspaces REQUIRES both =y. Without them containers cannot start.
# (Do NOT disable these for KernelSU-Next: it handles seccomp correctly.)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Control groups support -------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# --- Resource limits --------------------------------------------------------
# --pid-limit, then the accounting used to report CPU usage on kernels
# before 4.15.
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y

# -----------------------------------------------------------------------------
# NOTE: MEMCG IS DELIBERATELY NOT SET HERE. DO NOT ADD IT BACK.
# -----------------------------------------------------------------------------
# (Written without an "# CONFIG_MEMCG ..." prefix on purpose: kconfig parses any
#  line starting with that prefix as a definition and logs a bogus
#  "value is redefined" warning for it.)
# On this tree MEMCG and the kernel's low-memory killer are mutually exclusive:
#
#   drivers/android/Kconfig:78
#     config ANDROID_SIMPLE_LMK
#         depends on !ANDROID_LOW_MEMORY_KILLER && !MEMCG && !PSI
#
# X00TD_defconfig:688 enables ANDROID_SIMPLE_LMK (MINFREE=130) and this ROM has
# no PSI (# CONFIG_PSI is not set), so the in-kernel Simple LMK is the only
# thing that reclaims memory on this device. Turning MEMCG on does not just
# "add memory limits": it silently deletes ANDROID_SIMPLE_LMK -- kconfig emits
# no warning at all, the symbol simply vanishes from the final .config -- and
# the kernel then ships with no low-memory killer of any kind. The 2026-10-17
# builds (X00TD-MysticKernel-...-2e0fd9556 and ...-033aaca5e) did exactly that:
# minutes at the boot splash under reclaim thrash, then a freeze at the
# lock screen. Verify after any config change with:
#     grep -i lmk out/.config        # must show ANDROID_SIMPLE_LMK=y
#
# Cost of leaving MEMCG off: Droidspaces' --memory limit is skipped with a
# warning ("Memory limit support" shows as absent in the Requirements screen).
# --pids-limit and CPU usage accounting are unaffected: CGROUP_PIDS and
# CGROUP_CPUACCT do not depend on MEMCG. Upstream treats MEMCG as optional too
# ("a limit whose option is missing is skipped with a warning", Droidspaces-OSS
# Documentation/Kernel-Configuration.md).

# -----------------------------------------------------------------------------
# FAIR_GROUP_SCHED and CFS_BANDWIDTH are pinned off on purpose.
# -----------------------------------------------------------------------------
# Upstream Droidspaces lists both, because its --cpus limit needs CFS_BANDWIDTH.
# They do not compile on this tree.
#
# RSKSeven ships "FAIR_GROUP_SCHED is not set" in X00TD_defconfig, so the code
# under "#ifdef CONFIG_CFS_BANDWIDTH" in kernel/sched/fair.c (line 5503 to 6345)
# has never been compiled by anyone. It is a half-merged graft from a different
# code lineage and is syntactically broken. Enabling it yields 12 hard errors:
#
#   fair.c:5829: error: use of undeclared label 'unthrottle_throttle'
#   fair.c:5840: error: use of undeclared identifier 'qcfs_rq'
#   fair.c:5873: error: type specifier missing, defaults to 'int'
#   fair.c:5875..5881: syntax errors inside unthrottle_cfs_rq
#   fair.c:6152: error: no member named 'pelt_clock_throttled' in 'struct cfs_rq'
#
# It reads cfs_rq->pelt_clock_throttled (no such member exists in this tree's
# struct cfs_rq), a qcfs_rq variable that is not in scope there, and mainline
# 6.x constructs (se->sched_delayed, DEQUEUE_DELAYED). This is not a few-line
# fix: doing it properly means importing a working 4.19/CAF
# unthrottle_cfs_rq/throttle_cfs_rq/sync_throttle, i.e. deep scheduler surgery
# on a path that has never executed on this hardware.
#
# Cost of leaving them off: Droidspaces' --cpus limit is unavailable (the app
# greys the toggle out and warns). Memory limits (MEMCG), --pids-limit
# (CGROUP_PIDS) and CPU usage accounting still work. RSKSeven's own shipped
# kernel makes exactly this tradeoff, for the same reason.
# -----------------------------------------------------------------------------
# CONFIG_FAIR_GROUP_SCHED is not set
# CONFIG_CFS_BANDWIDTH is not set

# --- Device filesystem support ---------------------------------------------
CONFIG_DEVTMPFS=y

# --- Overlay filesystem support (volatile mode) ----------------------------
CONFIG_OVERLAY_FS=y

# --- tmpfs xattr / POSIX ACL (NixOS support) -------------------------------
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- Firmware loading support ---------------------------------------------
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# --- Networking: NAT / none modes -----------------------------------------
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# legacy compat (these two do exist on 4.19)
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# --- IPv6 in NAT mode (NAT66) ---------------------------------------------
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# legacy compat
CONFIG_NF_NAT_IPV6=y

# --- Macvlan mode ----------------------------------------------------------
CONFIG_MACVLAN=y

# --- Container internet on older kernels ----------------------------------
# Upstream asks for "CONFIG_ANDROID_PARANOID_NETWORK is not set". That symbol
# no longer exists in this CAF 4.19 tree (and is absent from the stock
# RSKSeven defconfig), so there is nothing to disable here.

# --- User namespaces -------------------------------------------------------
# "Allow Sandboxing" + fix for the docker "unsafe procfs" error.
CONFIG_USER_NS=y

# --- FUSE / TUN inside containers -----------------------------------------
# FUSE filesystems and VPNs running inside a container.
CONFIG_FUSE_FS=y
CONFIG_TUN=y

# --- Sparse image containers ----------------------------------------------
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y

# =============================================================================
# Optional: firewall support inside containers (UFW / Fail2Ban)
# =============================================================================
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# =============================================================================
# Default governor: the tree's own default (performance)
# =============================================================================
# This fragment previously selected CPU_FREQ_DEFAULT_GOV_SCHEDUTIL. Reverted:
# the 2026-10-17 builds were the only kernels that ever booted on schedutil
# here, and the ROM's power HAL sets the governor itself shortly after boot, so
# the compiled-in default only mattered during early boot anyway. RSKSeven's
# defconfig selects nothing, which makes drivers/cpufreq/Kconfig:50
# (CPU_FREQ_DEFAULT_GOV_PERFORMANCE) the effective default -- the same thing
# the previously stable kernels used. Pinned explicitly so the CI gate can
# assert it. No frequency table, voltage or thermal value is changed here, so
# runtime battery behaviour is identical: the ROM still applies schedutil.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

# =============================================================================
# SUSFS: OFF (by request — NoMount is used instead)
# =============================================================================
# KernelSU-Next is built without the SuSFS addon. Mount hiding is provided by
# the NoMount metamodule instead (userspace, install separately:
# github.com/maxsteeel/nomount/releases).
#
# Safe to switch off in this tree — every SuSFS call site outside fs/susfs.c is
# wrapped in #ifdef CONFIG_KSU_SUSFS*, and fs/Makefile only links susfs.o via
# "obj-$(CONFIG_KSU_SUSFS) += susfs.o". Verified call sites: fs/namei.c,
# fs/namespace.c, fs/notify/fdinfo.c, fs/proc/{base,cmdline,fd,task_mmu}.c,
# fs/proc_namespace.c, fs/readdir.c, fs/stat.c, fs/statfs.c, fs/super.c,
# kernel/kallsyms.c, kernel/sys.c, mm/memory.c, security/selinux/avc.c, plus
# the KernelSU-Next tree itself (core/init.c, hook/setuid_hook.c,
# supercall/supercall.c).
#
# The KSU_SUSFS_* sub-options all carry "depends on KSU_SUSFS" with default y,
# so they follow the parent and need no individual lines here.
# CONFIG_KSU_SUSFS is not set

# =============================================================================
# Identity — makes the resulting kernel easy to identify in `uname -r`:
#   4.19.325-MysticKernel/<commit>
# Overrides the "-RSKSevenProject" value set in vendor/asus/X00TD_defconfig.
# =============================================================================
CONFIG_LOCALVERSION="-MysticKernel"
