# Mystic extras. Merged last (EXTRA_CONFIG ordering), so it wins over the
# defconfigs. Keep this file tiny and commented: every line here shows up in
# the CI "effective diff vs RSKSeven baseline" output.

# KALLSYMS_ALL: keep static symbols too, so crash reports (and my own
# post-mortems) resolve file-local functions/data instead of raw addresses.
# Cost is a few hundred KB of .rodata; KALLSYMS=y is already set by the
# defconfig. CI asserts this survives the merge (warning only - it is a
# debug aid, not a functional requirement).
CONFIG_KALLSYMS_ALL=y
